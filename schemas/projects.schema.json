{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projects.schema.json",
  "title": "AIProject[]",
  "description": "src/data/projects.json：AI 项目资产库（100 项）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "category",
      "categoryIndex",
      "sourceFile",
      "name",
      "oneliner",
      "targetUsers",
      "painPoints",
      "coreFeatures",
      "mvpScope",
      "needsRAG",
      "needsAgent",
      "needsToolCalling",
      "needsMultimodal",
      "techStack",
      "risks",
      "difficulty",
      "estimatedDuration",
      "businessValueRating",
      "scores",
      "avgScore",
      "dataMissing"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^\\d{2}-\\d{3}$"
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "categoryIndex": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "sourceFile": {
        "type": "string",
        "minLength": 1
      },
      "englishName": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "oneliner": {
        "type": "string"
      },
      "targetUsers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "painPoints": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "traditionalSolutionWeakness": {
        "type": "string"
      },
      "aiIntervention": {
        "type": "string"
      },
      "coreFeatures": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "mvpScope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "v1Scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "outOfScope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "userFlow": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "pageStructure": {
        "type": "string"
      },
      "dataSource": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dataStructure": {
        "type": "string"
      },
      "needsRAG": {
        "type": "boolean"
      },
      "needsAgent": {
        "type": "boolean"
      },
      "needsToolCalling": {
        "type": "boolean"
      },
      "needsMultimodal": {
        "type": "boolean"
      },
      "promptTemplate": {
        "type": "string"
      },
      "techStack": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frontend",
          "backend",
          "database"
        ],
        "properties": {
          "frontend": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "database": {
            "type": "string"
          }
        }
      },
      "apiDesign": {
        "type": "string"
      },
      "keyAlgorithms": {
        "type": "string"
      },
      "risks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "testingStrategy": {
        "type": "string"
      },
      "deploymentPlan": {
        "type": "string"
      },
      "difficulty": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5,
        "description": "1-5；0 表示源文档未给出评级"
      },
      "estimatedDuration": {
        "type": "string",
        "minLength": 1
      },
      "businessValueRating": {
        "type": "string"
      },
      "monetization": {
        "type": "string"
      },
      "competitiveAnalysis": {
        "type": "string"
      },
      "differentiationText": {
        "type": "string"
      },
      "allSolutions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "resumeTemplate": {
        "type": "string"
      },
      "scores": {},
      "avgScore": {},
      "dataMissing": {
        "type": "boolean",
        "description": "true = 原始资料缺失，只有名称/功能列表，不展示评分"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "dataMissing": {
              "const": true
            }
          }
        },
        "then": {
          "properties": {
            "scores": {
              "type": "null"
            },
            "avgScore": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "scores": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resumeValue",
                "businessValue",
                "techGrowth",
                "freelanceValue",
                "developability",
                "differentiation",
                "longTermReuse"
              ],
              "properties": {
                "resumeValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "businessValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "techGrowth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "freelanceValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "developability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "differentiation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "longTermReuse": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            },
            "avgScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "oneliner": {
              "type": "string",
              "minLength": 1
            },
            "targetUsers": {
              "type": "array",
              "minItems": 1
            },
            "painPoints": {
              "type": "array",
              "minItems": 1
            },
            "mvpScope": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    ]
  }
}
