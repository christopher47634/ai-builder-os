{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "customer-profiles.schema.json",
  "title": "CustomerProfile[]",
  "description": "src/data/customerProfiles.json：客户画像",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "type",
      "willingToPayFor",
      "aiMisconceptions",
      "approach",
      "firstMessage",
      "firstCallSteps",
      "budgetIndicators",
      "pricingStrategy",
      "closingTactics"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "type": {
        "type": "string",
        "minLength": 1
      },
      "willingToPayFor": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "aiMisconceptions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "approach": {
        "type": "string",
        "minLength": 1
      },
      "firstMessage": {
        "type": "string",
        "minLength": 1
      },
      "firstCallSteps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "budgetIndicators": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "pricingStrategy": {
        "type": "string",
        "minLength": 1
      },
      "closingTactics": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    }
  }
}
