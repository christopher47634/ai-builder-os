{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflows.schema.json",
  "title": "WorkflowTemplate[]",
  "description": "src/data/workflows.json：工作流模板（200 项）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "category",
      "targetUser",
      "painPoint",
      "input",
      "output",
      "trigger",
      "steps",
      "tools",
      "apis",
      "promptTemplate",
      "humanCheckpoints",
      "automationBoundary",
      "errorHandling",
      "privacyRisk",
      "timeSaved",
      "pricing",
      "demoApproach",
      "productionApproach",
      "reusableModules",
      "difficulty",
      "industry",
      "businessValue"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z-]+-\\d{2}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "targetUser": {
        "type": "string"
      },
      "painPoint": {
        "type": "string"
      },
      "input": {
        "type": "string"
      },
      "output": {
        "type": "string"
      },
      "trigger": {
        "type": "string"
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "tools": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "apis": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "promptTemplate": {
        "type": "string"
      },
      "humanCheckpoints": {
        "type": "string"
      },
      "automationBoundary": {
        "type": "string"
      },
      "errorHandling": {
        "type": "string"
      },
      "privacyRisk": {
        "type": "string"
      },
      "timeSaved": {
        "type": "string"
      },
      "pricing": {
        "type": "string"
      },
      "demoApproach": {
        "type": "string"
      },
      "productionApproach": {
        "type": "string"
      },
      "reusableModules": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "difficulty": {
        "enum": [
          "入门",
          "中级",
          "高级"
        ]
      },
      "industry": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "businessValue": {
        "enum": [
          "高",
          "中",
          "低"
        ]
      }
    }
  }
}
